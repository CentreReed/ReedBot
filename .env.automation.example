# Disabled until the PR is reviewed and a single Render Web Service is ready.
AUTOMATION_API_ENABLED=false
# Required when enabled. Supply a private random secret, at least 32 characters.
AUTOMATION_API_TOKEN=
# The first two n8n workflows need these scopes only.
AUTOMATION_API_SCOPES=read,mandates:write
# Empty means use the existing GUILD_ID.
AUTOMATION_GUILD_IDS=
# Optional category for private tutor forums; IDs remain strings.
AUTOMATION_TUTOR_CATEGORY_ID=
# Staff roles that may see private tutor forums, in addition to tutor/bot/admins.
AUTOMATION_STAFF_ROLE_IDS=
# Set only after the current progress.json has been copied to a persistent disk.
# PROGRESS_FILE=/var/data/progress.json
# Render provides PORT; local default is 10000.
